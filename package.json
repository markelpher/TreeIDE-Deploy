{
  "name": "tree-ide",
  "version": "2.0.80",
  "description": "Tree IDE, a lightweight, open-source project structure editor",
  "author": "Mare <treeide@immare.xyz>",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/markelpher/TreeIDE-Deploy.git"
  },
  "type": "module",
  "main": "src/main/main.js",
  "desktopName": "com.treeide.treeide.desktop",
  "scripts": {
    "start": "vite build && node scripts/start-electron.cjs",
    "dev": "node scripts/dev.cjs",
    "build:renderer": "vite build",
    "build": "vite build && electron-builder",
    "build:mac": "vite build && electron-builder --mac dmg zip --arm64",
    "postinstall": "node scripts/ensure-electron.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons:generate": "node scripts/generate-lucide-local.mjs",
    "i18n:validate": "node scripts/validate-i18n.mjs",
    "lint": "eslint . --ext .js,.mjs",
    "lint:fix": "eslint . --ext .js,.mjs --fix",
    "format": "prettier --check \"src/**/*.js\" \"src/**/*.css\" \"tests/**/*.js\"",
    "format:fix": "prettier --write \"src/**/*.js\" \"src/**/*.css\" \"tests/**/*.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-reloader": "^1.2.3",
    "eslint": "^10.5.0",
    "happy-dom": "^20.10.6",
    "lucide-static": "^1.22.0",
    "prettier": "^3.8.4",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.treeide.treeide",
    "productName": "Tree IDE",
    "beforePack": "scripts/electron-before-pack.cjs",
    "releaseInfo": {
      "releaseName": "Tree IDE v${version}"
    },
    "win": {
      "target": [
        "nsis",
        "msi",
        "portable"
      ],
      "executableName": "Tree IDE",
      "icon": "assets/icon-no-bg.ico",
      "publish": [
        {
          "provider": "github",
          "owner": "markelpher",
          "repo": "TreeIDE-Deploy",
          "releaseType": "draft"
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "artifactName": "Tree-IDE-Setup-${version}-win-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": true,
      "installerIcon": "assets/icon-no-bg.ico",
      "uninstallerIcon": "assets/icon-no-bg.ico",
      "installerLanguages": [
        "en_US",
        "pt_BR",
        "es_ES"
      ],
      "multiLanguageInstaller": true,
      "displayLanguageSelector": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tree IDE",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "Tree-IDE-Portable-${version}-win-${arch}.${ext}"
    },
    "msi": {
      "artifactName": "Tree-IDE-${version}-win-${arch}.${ext}",
      "perMachine": true,
      "additionalLightArgs": [
        "-cultures:pt-br"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "snap"
      ],
      "icon": "assets/icon-no-bg.png",
      "category": "Development",
      "publish": [
        {
          "provider": "github",
          "owner": "markelpher",
          "repo": "TreeIDE-Deploy",
          "releaseType": "draft"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon-no-bg.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "Tree-IDE-${version}-macOS-${arch}.${ext}",
      "publish": [
        {
          "provider": "github",
          "owner": "markelpher",
          "repo": "TreeIDE-Deploy",
          "releaseType": "draft"
        }
      ]
    },
    "dmg": {
      "artifactName": "Tree-IDE-${version}-macOS-${arch}.${ext}",
      "title": "Tree IDE ${version}"
    },
    "deb": {
      "artifactName": "Tree-IDE-${version}-${arch}.${ext}",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "snap": {
      "artifactName": "Tree-IDE-${version}-${arch}.${ext}",
      "confinement": "strict",
      "summary": "A lightweight project structure editor",
      "grade": "stable",
      "plugs": [
        "default",
        "removable-media"
      ],
      "environment": {
        "TMPDIR": "$XDG_RUNTIME_DIR"
      }
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "src/shared/**/*",
      "dist/renderer/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/7zip-bin/**/*"
    ]
  },
  "dependencies": {
    "semver": "^7.7.3",
    "7zip-min": "^3.0.1",
    "adm-zip": "^0.5.17",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "electron-winstaller": "^5.4.0",
    "node-unrar-js": "^2.0.2"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "electron": true
  }
}
